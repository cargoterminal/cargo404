# Cargo404 env

# Deployer private key WITHOUT 0x recommended by Hardhat. Keep this secret.
PRIVATE_KEY=

# BNB Chain RPCs
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Optional verification
BSCSCAN_API_KEY=

# Treasury receives 20% of raised BNB after distributeRaisedBnb()
TREASURY_ADDRESS=

# Buyback wallet receives 10% of raised BNB after distributeRaisedBnb()
BUYBACK_WALLET=
